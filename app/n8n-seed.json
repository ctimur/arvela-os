{
"id": "ace2b5c3-dd58-50a7-95db-0efe25e68455",
"name": "Eskileri seç",
"type": "n8n-nodes-base.code",
"typeVersion": 2,
"position": [
480,
300
],
"parameters": {
"jsCode": "const esc = (s) => String(s ?? '').replace(/[&<>]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));\nconst now = Date.now(); const rows = $input.first().json.data || [];\nconst wa = (p, t) => { let d = String(p || '').replace(/\\D/g, ''); if (d.length === 11 && d.startsWith('0')) d = '90' + d.slice(1); if (d.length === 10 && d.startsWith('5')) d = '90' + d; return d.length >= 11 ? `https://wa.me/${d}?text=${encodeURIComponent(`Merhaba, \"${t}\" onayınızı bekliyor. Portalınızdan bakabilirsiniz.`)}` : null; };\nconst old = rows.filter(a => now - new Date(a.created_at) >= 2 * 864e5);\nif (!old.length) return [];\nconst html = '<h2 style=\"font-family:Arial\">2 günden uzun süredir onay bekleyenler</h2><ul>' + old.map(a => { const l = wa(a.client_phone, a.title); return `<li><strong>${esc(a.title)}</strong> — ${esc(a.client)} · ${Math.floor((now - new Date(a.created_at)) / 864e5)} gün ${l ? `· <a href=\"${l}\">WhatsApp'tan hatırlat</a>` : ''}</li>`; }).join('') + '</ul><p style=\"color:#6B6558\">Müşteriye mesaj göndermeden önce İYS/KVKK iznini kontrol et.</p>';\nreturn [{ json: { html, count: old.length } }];"
}
},
