{
"id": "f0c44fed-6f33-58ab-83ee-994de85b2f4d",
"name": "Özeti hazırla",
"type": "n8n-nodes-base.code",
"typeVersion": 2,
"position": [
480,
300
],
"parameters": {
"jsCode": "const esc = (s) => String(s ?? '').replace(/[&<>]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));\nconst li = (arr, f) => arr && arr.length ? '<ul>' + arr.map(x => '<li>' + f(x) + '</li>').join('') + '</ul>' : '<p style=\"color:#6B6558\">Yok.</p>';\nconst s = $input.first().json;\nconst n = s.counts || {};\nconst html = `<h2 style=\"font-family:Arial\">Günaydın · ${s.date}</h2>\n<p>${n.clients} aktif müşteri · ${n.open_projects} açık proje · ${n.open_tasks} açık görev · ${n.pending_approvals} bekleyen onay</p>\n<h3>Geciken görevler</h3>${li(s.overdue_tasks, t => `${esc(t.title)} — ${esc(t.project)} · ${esc(t.assignee || 'atanmadı')} · ${String(t.due_date).slice(0,10)}`)}\n<h3>Bugün teslim</h3>${li(s.due_today, t => `${esc(t.title)} — ${esc(t.project)} · ${esc(t.assignee || 'atanmadı')}`)}\n<h3>Onay bekleyenler</h3>${li(s.pending_approvals, a => `${esc(a.title)} — ${esc(a.client)}`)}\n<h3>Acil siteler</h3>${li(s.urgent_sites, x => `${esc(x.domain)} — ${esc(x.client || '')} ${esc(x.issue || x.ssl_status || '')}`)}\n${s.overdue_invoices ? '<h3>Gecikmiş faturalar</h3>' + li(s.overdue_invoices, i => `${esc(i.number)} — ${esc(i.client)}`) : ''}\n<p><a href=\"${s.url}\">Arvela OS'te Bugün sayfasını aç</a></p>`;\nreturn [{ json: { html, subject: `Arvela · ${s.date} günlük özet` } }];"
}
},
