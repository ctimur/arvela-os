{
"id": "818e5843-3b58-535a-943f-c91863501e35",
"name": "Listeyi hazırla",
"type": "n8n-nodes-base.code",
"typeVersion": 2,
"position": [
480,
300
],
"parameters": {
"jsCode": "const esc = (s) => String(s ?? '').replace(/[&<>]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));\nconst rows = $input.first().json.data || [];\nif (!rows.length) return [];\nconst sum = rows.reduce((a, i) => a + (i.total || 0), 0);\nconst html = '<h2 style=\"font-family:Arial\">Gecikmiş faturalar</h2><ul>' + rows.map(i => `<li><strong>${esc(i.number)}</strong> — ${esc(i.client)} · ${new Intl.NumberFormat('tr-TR').format(i.total || 0)} ${i.currency === 'EUR' ? '€' : 'TL'} · vade ${String(i.due_date).slice(0, 10)}${i.client_notified_at ? ' · <em>müşteri ödedim dedi</em>' : ''}</li>`).join('') + `</ul><p>Toplam: ${new Intl.NumberFormat('tr-TR').format(sum)}</p><p><a href=\"https://os.arveladigital.com/faturalar\">Faturaları aç</a></p>`;\nreturn [{ json: { html, count: rows.length } }];"
}
},
